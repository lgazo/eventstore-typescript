{
  "name": "eventstore-typescript",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:postgres && npm run build:d1 && npm run build:supabase",
    "build:core": "npm run build -w @lgazo/eventstore",
    "build:postgres": "npm run build -w @lgazo/eventstore-postgres",
    "build:d1": "npm run build -w @lgazo/eventstore-d1",
    "build:supabase": "npm run build -w @lgazo/eventstore-supabase",
    "build:watch": "npm run build -w @lgazo/eventstore -- --watch",
    "clean": "rm -rf packages/*/dist",
    "dev": "ts-node -r tsconfig-paths/register packages/core/src/index.ts",
    "example": "ts-node -r tsconfig-paths/register packages/core/src/examples/banking/cli.ts",
    "simple": "ts-node -r tsconfig-paths/register simple.ts",
    "supabase:sql": "ts-node -r tsconfig-paths/register scripts/generate-supabase-setup-sql.ts",
    "test": "jest",
    "test:supabase:scenario": "jest --runInBand tests/supabase.scenario.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'packages/**/src/**/*.ts' --ignore-pattern '**/__tests__/**' --no-warn-ignored",
    "lint:fix": "eslint 'packages/**/src/**/*.ts' --ignore-pattern '**/__tests__/**' --no-warn-ignored --fix",
    "format": "prettier --write 'packages/**/src/**/*.ts'",
    "format:check": "prettier --check 'packages/**/src/**/*.ts'"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "overrides": {
    "glob": "^10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgazo/eventstore-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/lgazo/eventstore-typescript/issues"
  },
  "homepage": "https://github.com/lgazo/eventstore-typescript#readme"
}
