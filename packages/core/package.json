    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "eventstore",
    "event-sourcing",
    "eventsourcing",
    "typescript",
    "events",
    "postgresql",
    "postgres",
    "real-time",
    "subscriptions",
    "projections",
    "event-driven",
    "cqrs"
  ],
