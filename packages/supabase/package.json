    "supabase",
    "event-driven"
  ],
  "author": "Rico Fritzsche",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgazo/eventstore-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/lgazo/eventstore-typescript/issues"
  },
  "homepage": "https://github.com/lgazo/eventstore-typescript#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@lgazo/eventstore": "^1.1.0"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
