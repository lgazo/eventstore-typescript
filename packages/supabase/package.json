{
  "name": "@lgazo/eventstore-supabase",
  "version": "1.1.0",
  "description": "Supabase-backed store for @lgazo/eventstore",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "eventstore",
