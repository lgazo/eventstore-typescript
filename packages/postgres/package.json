{
  "name": "@lgazo/eventstore-postgres",
  "version": "1.2.0",
  "description": "PostgreSQL-backed store for @lgazo/eventstore",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "eventstore",
    "event-sourcing",
    "postgres",
    "postgresql",
    "event-driven"
  ],
  "author": "Rico Fritzsche",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgazo/eventstore-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/lgazo/eventstore-typescript/issues"
  },
  "homepage": "https://github.com/lgazo/eventstore-typescript#readme",
  "dependencies": {
    "pg": "^8.11.0",
    "@lgazo/eventstore": "^1.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.0"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
